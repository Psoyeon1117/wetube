extends base.pug

block content 
	if errorMessage
		span=errorMessage
	form(method="POST")
		input(placeholder="Title", type="text", name="title",required, maxlength=80)
		input(placeholder="Hashtags", required, type="text", name="hashtags")
		input(placeholder="Description", required, type="text", name="description", minlength=20)
		input(type="submit", value="Upload video")